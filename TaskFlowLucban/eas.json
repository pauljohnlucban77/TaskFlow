{
  "cli": {
    "version": ">= 15.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "preview"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_DATA_SOURCE": "firebase",
        "EXPO_PUBLIC_DEMO_MODE": "true"
      },
      "android": {
        "buildType": "apk"
      }
    }
  }
}
