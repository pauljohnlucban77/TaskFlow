# Data source must be explicitly set to "mock" or "firebase".
# Mock data provides a ready-to-run local presentation without Firebase.
# Private preview builds should use "firebase" with a dedicated staging project.
EXPO_PUBLIC_DATA_SOURCE=mock
EXPO_PUBLIC_DEMO_MODE=true

# Firebase Web Config (required when EXPO_PUBLIC_DATA_SOURCE=firebase).
# Restrict the Firebase API key in Google Cloud Console to the deployed app/domain and required APIs.
EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id
